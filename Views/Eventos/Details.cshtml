@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Detalles del Evento";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-3 fs-4 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-dark mb-0">@Model.Titulo</h3>
                        <p class="text-muted small mb-0">Información detallada del evento</p>
                    </div>
                </div>
                <span class="badge bg-primary-subtle text-primary border px-3 py-2 rounded-pill">@Model.Modalidad</span>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3">
                        <span class="text-muted small d-block mb-1"><i class="bi bi-calendar-event me-1"></i> Fecha y Hora</span>
                        <strong class="text-dark">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3">
                        <span class="text-muted small d-block mb-1"><i class="bi bi-geo-alt me-1"></i> Lugar</span>
                        <strong class="text-dark">@Model.Lugar</strong>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3">
                        <span class="text-muted small d-block mb-1"><i class="bi bi-cash me-1"></i> Precio</span>
                        <strong class="text-success fs-5">$@Model.Precio.ToString("N2")</strong>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3">
                        <span class="text-muted small d-block mb-1"><i class="bi bi-people me-1"></i> Aforo Máximo</span>
                        <strong class="text-dark fs-5">@Model.Aforo</strong>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between pt-2">
                <a asp-action="Index" class="btn btn-light px-4 py-2 fw-semibold text-muted rounded-3 border-0">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Editar Evento
                </a>
            </div>
        </div>
    </div>
</div>