@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Editar Evento";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="p-3 rounded-3 fs-4 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background-color: #fef3c7 !important; color: #d97706 !important;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Editar Evento</h3>
                    <p class="text-muted small mb-0">Modifica los detalles de la agenda</p>
                </div>
            </div>

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-3"></div>
                
                <!-- ID Oculto obligatorio para que el controlador identifique el registro -->
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label fw-semibold text-secondary small">Título del Evento</label>
                    <input asp-for="Titulo" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" />
                    <span asp-validation-for="Titulo" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoriaId" class="form-label fw-semibold text-secondary small">Categoría</label>
                        <select asp-for="CategoriaId" class="form-select form-select-lg bg-light border-0 rounded-3 fs-6" asp-items="ViewBag.Categorias">
                            <option value="">-- Seleccione Categoría --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Modalidad" class="form-label fw-semibold text-secondary small">Modalidad</label>
                        <select asp-for="Modalidad" class="form-select form-select-lg bg-light border-0 rounded-3 fs-6">
                            <option value="Presencial">Presencial</option>
                            <option value="Virtual">Virtual</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Fecha" class="form-label fw-semibold text-secondary small">Fecha y Hora</label>
                        <input asp-for="Fecha" type="datetime-local" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" />
                        <span asp-validation-for="Fecha" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Lugar" class="form-label fw-semibold text-secondary small">Lugar / Plataforma</label>
                        <input asp-for="Lugar" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" />
                        <span asp-validation-for="Lugar" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Precio" class="form-label fw-semibold text-secondary small">Precio ($)</label>
                        <input asp-for="Precio" type="number" step="0.01" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" />
                        <span asp-validation-for="Precio" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Aforo" class="form-label fw-semibold text-secondary small">Aforo Máximo</label>
                        <input asp-for="Aforo" type="number" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" />
                        <span asp-validation-for="Aforo" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between gap-3 pt-2">
                    <a asp-action="Index" class="btn btn-light px-4 py-2 fw-semibold text-muted rounded-3 border-0">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}