@model IEnumerable<Eventos.Web.Models.Evento>

@{
    ViewData["Title"] = "Gestión de Eventos";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Eventos Disponibles</h2>
        <p class="text-muted small mb-0">Explora, filtra y administra la agenda corporativa y académica.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-circle-fill fs-5"></i> Crear Nuevo Evento
    </a>
</div>

<!-- Barra de Filtros opcional -->
<div class="card shadow-sm border-0 rounded-4 p-3 mb-4 bg-white">
    <div class="row align-items-center g-3">
        <div class="col-md-auto">
            <label class="form-label fw-semibold text-secondary small mb-0"><i class="bi bi-filter me-1"></i> Filtrar por Categoría:</label>
        </div>
        <div class="col-md-4">
            <!-- Selector de categorías si aplica -->
            <select class="form-select border-light bg-light rounded-3">
                <option selected>-- Todas las Categorías --</option>
            </select>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-custom">
                <thead>
                    <tr>
                        <th class="ps-4">Título</th>
                        <th>Categoría</th>
                        <th>Fecha</th>
                        <th>Lugar</th>
                        <th>Modalidad</th>
                        <th>Precio</th>
                        <th>Aforo</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@item.Titulo</td>
                            <td><span class="badge bg-secondary-subtle text-secondary border">Tecnología</span></td>
                            <td class="text-muted small">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.Lugar</td>
                            <td>
                                @if (item.Modalidad == "Presencial")
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">Presencial</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">Virtual</span>
                                }
                            </td>
                            <td class="fw-bold text-success">$@item.Precio.ToString("N2")</td>
                            <td><span class="badge bg-light text-dark border">@item.Aforo</span></td>
                            <td class="text-end pe-4">
                                <div class="btn-group gap-1" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-2 px-2" title="Detalles"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-2 px-2" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-2 px-2" title="Eliminar"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>