@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Eliminar Evento";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white border-top border-danger border-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="p-3 rounded-3 fs-4 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background-color: #fee2e2 !important; color: #dc2626 !important;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">¿Eliminar Evento?</h3>
                    <p class="text-muted small mb-0">Esta acción no se puede deshacer fácilmente</p>
                </div>
            </div>

            <div class="p-4 bg-light rounded-4 mb-4">
                <h5 class="fw-bold text-dark mb-3">@Model.Titulo</h5>
                <ul class="list-unstyled text-secondary small mb-0 g-2 d-flex flex-column gap-2">
                    <li><i class="bi bi-calendar-event me-2 text-primary"></i><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</li>
                    <li><i class="bi bi-geo-alt me-2 text-primary"></i><strong>Lugar:</strong> @Model.Lugar</li>
                    <li><i class="bi bi-cash me-2 text-success"></i><strong>Precio:</strong> $@Model.Precio.ToString("N2")</li>
                    <li><i class="bi bi-people me-2 text-primary"></i><strong>Aforo:</strong> @Model.Aforo personas</li>
                </ul>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <a asp-action="Index" class="btn btn-light px-4 py-2 fw-semibold text-muted rounded-3 border-0">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger px-4 py-2 rounded-3 fw-semibold shadow-sm">
                        <i class="bi bi-trash-fill me-1"></i> Sí, Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>