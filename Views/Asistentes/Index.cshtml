@model IEnumerable<Eventos.Web.Models.Asistente>

@{
    ViewData["Title"] = "Gestión de Asistentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Directorio de Asistentes</h2>
        <p class="text-muted small mb-0">Gestiona y revisa los participantes registrados en la plataforma.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-person-plus-fill"></i> Registrar Asistente
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Nombres</th>
                        <th>DNI</th>
                        <th>Correo Electrónico</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                No hay asistentes registrados actualmente.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 36px; height: 36px;">
                                            @item.Nombres.Substring(0, 1).ToUpper()
                                        </div>
                                        @item.Nombres
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.Dni</span></td>
                                <td>@item.Correo</td>
                                <td>@(string.IsNullOrEmpty(item.Telefono) ? "-" : item.Telefono)</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">Inactivo</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>